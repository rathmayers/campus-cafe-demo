---
import Layout from '../../layouts/AfterLayout.astro';
import { cafe } from '../../data/cafe';
---
<Layout title="Imprint" description="Legal notice (Impressum) of the fictional Campus Café teaching demo.">
  <h1 class="text-4xl font-bold">Imprint</h1>
  <div class="mt-6 max-w-prose space-y-4 leading-relaxed">
    <p><strong>Note:</strong> Campus Café is fictional. This website is a teaching demo for the course CM-501 Frontend Web Development. A real German website needs a complete legal notice (Impressum) according to § 5 DDG.</p>
    <p>{cafe.name}<br />{cafe.street}<br />{cafe.city}</p>
    <p>Represented by: Jane Example<br />Contact: {cafe.email}</p>
  </div>
</Layout>
