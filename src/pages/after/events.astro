---
import Layout from '../../layouts/AfterLayout.astro';
import { events, url } from '../../data/cafe';
---
<Layout title="Events" description="Open Mic Night, Exam Study Marathon and Latte Art Workshop: upcoming events at Campus Café.">
  <h1 class="text-4xl font-bold">Events</h1>
  <p class="mt-4 text-lg">What's on at Campus Café this semester.</p>
  <ul class="mt-8 space-y-6">
    {events.map((e) => (
      <li>
        <article aria-labelledby={`ev-${e.slug}`} class="rounded-xl border-2 border-bean-100 bg-white p-6">
          <h2 id={`ev-${e.slug}`} class="text-2xl font-bold">{e.title}</h2>
          <p class="mt-1 font-bold"><time datetime={e.date}>{e.dateLabel}</time>, {e.time}</p>
          <p class="mt-2">{e.text}</p>
          <p class="mt-3"><a href={url('/after/contact/')}>Reserve a seat for {e.title}</a></p>
        </article>
      </li>
    ))}
  </ul>
</Layout>
