---
import Layout from '../../layouts/AfterLayout.astro';
import { cafe, url } from '../../data/cafe';
const field = 'mt-1 block w-full rounded-md border-2 border-bean-800 bg-white px-3 py-2 text-base';
---
<Layout title="Contact & reservations" description="Address, phone and e-mail of Campus Café, plus a form to reserve a table or a seat at one of our events.">
  <h1 class="text-4xl font-bold">Contact & reservations</h1>

  <div class="mt-8 grid gap-10 md:grid-cols-2">
    <section aria-labelledby="find-heading">
      <h2 id="find-heading" class="text-2xl font-bold">Find us</h2>
      <address class="mt-3 not-italic leading-relaxed">
        {cafe.street}<br />{cafe.city}<br />
        Phone: <a href={`tel:${cafe.phone.replace(/\s/g, '')}`}>{cafe.phone}</a><br />
        E-mail: <a href={`mailto:${cafe.email}`}>{cafe.email}</a>
      </address>
      <p class="mt-4">
        <a href="https://www.openstreetmap.org/search?query=Munich" rel="noopener">Open the map on OpenStreetMap <span class="sr-only">(external site)</span></a>
      </p>
      <p class="mt-2 text-sm">We link to the map instead of embedding it, so no data is sent to a map provider unless you click.</p>
    </section>

    <section aria-labelledby="form-heading">
      <h2 id="form-heading" class="text-2xl font-bold">Reserve a table</h2>
      <p class="mt-1 text-sm">Fields marked with * are required.</p>
      <form id="reserve" class="mt-4 space-y-4" novalidate>
        <div>
          <label for="name" class="font-bold">Name *</label>
          <input id="name" name="name" type="text" autocomplete="name" required class={field} />
        </div>
        <div>
          <label for="email" class="font-bold">E-mail *</label>
          <input id="email" name="email" type="email" autocomplete="email" required aria-describedby="email-hint" class={field} />
          <p id="email-hint" class="mt-1 text-sm">We only use it to confirm your reservation.</p>
        </div>
        <div>
          <label for="date" class="font-bold">Date *</label>
          <input id="date" name="date" type="date" required class={field} />
        </div>
        <div>
          <label for="msg" class="font-bold">Message</label>
          <textarea id="msg" name="msg" rows="4" class={field}></textarea>
        </div>
        <button type="submit" class="rounded-md bg-bean-900 px-6 py-3 font-bold text-bean-50 hover:bg-bean-800">Send reservation</button>
        <p id="form-status" role="status" class="font-bold"></p>
      </form>
    </section>
  </div>
</Layout>

<!-- External file (not inline) so the Content-Security-Policy can stay strict: script-src 'self' -->
<script is:inline type="module" src={url('/after/reserve.js')}></script>
