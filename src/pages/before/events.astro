---
import Layout from '../../layouts/BeforeLayout.astro';
import { url, events } from '../../data/cafe';
---
<Layout>
  <h1 class="h">Events</h1>
  <h1 class="h" style="font-size:18px">What's on</h1>
  <img src={url('/before/img/event.png')} style="width:1100px">
  {events.map((e) => (
    <div style="margin:20px 0">
      <h5 class="h" style="font-size:26px">{e.title}</h5>
      <div>{e.dateLabel}, {e.time}</div>
      <div>{e.text} <a href="../contact/">Click here</a></div>
    </div>
  ))}
</Layout>
