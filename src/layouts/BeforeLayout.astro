---
/**
 * BEFORE version — built badly ON PURPOSE for teaching (CM-501, Session 1).
 * Every problem in here is deliberate and documented in the answer key
 * (teaching-material/session-01/demo-answer-key.md). Do not copy!
 */
import { url } from '../data/cafe';
const base = url('/before/');
---
<html>
<head>
<meta charset="utf-8">
<title>Home</title>
<!-- Fonts straight from Google: third-party request, visitor IP goes to Google before any consent -->
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lobster&family=Raleway:wght@200;800&display=block">
<!-- Libraries "just in case" — render-blocking, mostly unused -->
<script is:inline src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/lodash@4.17.21/lodash.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/moment@2.30.1/min/moment-with-locales.js"></script>
<style is:inline>
  * { outline: none !important; }
  body { margin: 0; background: #fff; font-family: 'Raleway', sans-serif; font-weight: 200; font-size: 13px; color: #b3b3b3; }
  #wrap { width: 1100px; margin: 0 auto; }
  .top { background: #3b2a20; height: 90px; position: relative; }
  .logo { font-family: 'Lobster', cursive; font-size: 44px; color: #6b4a36; position: absolute; left: 20px; top: 16px; }
  .nav { position: absolute; right: 10px; top: 34px; }
  .nav div { display: inline-block; margin-left: 4px; padding: 2px 4px; font-size: 11px; color: #8a6d5a; cursor: pointer; }
  .nav div:hover { color: #fff; }
  .ticker { background: #f4ede4; color: #c8b8a6; font-size: 12px; padding: 4px 0; }
  .slider { position: relative; height: 460px; overflow: hidden; }
  .slider img { position: absolute; top: 0; left: 0; width: 1100px; transition: opacity 0.6s; opacity: 0; }
  .slider img.on { opacity: 1; }
  .h { font-family: 'Lobster', cursive; color: #d9c6b4; font-size: 30px; margin: 22px 0 6px; font-weight: normal; }
  .box { float: left; width: 340px; margin: 10px 20px 10px 0; }
  .box img { width: 340px; }
  .btn { display: inline-block; background: #e9e0d6; color: #fff; padding: 3px 6px; font-size: 11px; cursor: pointer; }
  .btn2 { display: inline-block; border: 1px dotted #ccc; color: #999; padding: 6px 18px; font-family: Georgia; text-transform: uppercase; cursor: pointer; }
  .clear { clear: both; }
  table.layout td { vertical-align: top; padding: 4px 18px 4px 0; }
  .foot { background: #3b2a20; color: #6b4a36; padding: 20px; margin-top: 40px; font-size: 11px; }
  .foot svg { width: 14px; height: 14px; fill: #6b4a36; margin-right: 8px; }
  .ad { background: #ffe14d; color: #333; text-align: center; font-size: 22px; font-weight: 800; padding: 28px 0; }
  #cookie { position: fixed; bottom: 0; left: 0; right: 0; background: rgba(30,20,15,.96); color: #ddd; padding: 26px; font-size: 14px; z-index: 9; }
  #cookie .yes { background: #3cb371; color: #fff; font-size: 18px; padding: 12px 40px; display: inline-block; cursor: pointer; margin-right: 20px; }
  #cookie .more { color: #555; font-size: 10px; cursor: pointer; }
  input, textarea { border: 1px solid #eee; padding: 6px; width: 300px; color: #bbb; font-family: inherit; }
  ::placeholder { color: #ddd; }
</style>
</head>
<body>
<div id="wrap">
  <div class="top">
    <div class="logo">Campus Café</div>
    <div class="nav">
      <div onclick={`location.href='${base}'`}>HOME</div>
      <div onclick={`location.href='${base}menu/'`}>MENU</div>
      <div onclick={`location.href='${base}events/'`}>EVENTS</div>
      <div onclick={`location.href='${base}contact/'`}>CONTACT</div>
    </div>
  </div>
  <div id="adslot"></div>
  <slot />
  <div class="foot">
    <a href="#"><svg viewBox="0 0 24 24"><path d="M14 8h3V4h-3c-2.8 0-4 1.7-4 4v2H8v4h2v8h4v-8h3l1-4h-4V8.5c0-.4.2-.5.5-.5z"/></svg></a>
    <a href="#"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="#6b4a36" stroke-width="2"/></svg></a>
    <a href="#"><svg viewBox="0 0 24 24"><path d="M4 4l16 16M20 4L4 20" stroke="#6b4a36" stroke-width="3"/></svg></a>
    <br><br>© Campus Café
  </div>
</div>

<div id="cookie">
  We value your privacy 🍪 We and our 143 partners use cookies to give you the best experience, personalised ads and analytics.
  By continuing to browse you agree.<br><br>
  <div class="yes" onclick="document.getElementById('cookie').style.display='none'">ACCEPT ALL</div>
  <span class="more" onclick="return false">more options</span>
</div>

<script is:inline>
  // "Analytics": runs immediately — long before anybody clicks the cookie banner
  document.cookie = "_cc_uid=" + Math.random().toString(36).slice(2) + "; max-age=31536000; path=/";
  document.cookie = "_cc_seen=" + Date.now() + "; max-age=31536000; path=/";
  localStorage.setItem("cc_fingerprint", navigator.userAgent + "|" + screen.width + "x" + screen.height + "|" + navigator.language);

  // TODO remove before go-live!!
  var PAYMENT_API_KEY = "sk_live_DEMO_NOT_A_REAL_KEY_4f9a2c7e1b";
  var ADMIN_PASSWORD = "cafe2026";

  // Ad banner pushes the whole page down after 1.5 s (layout shift)
  setTimeout(function () {
    document.getElementById("adslot").innerHTML = '<div class="ad">★ STUDENT DEAL: 2 COFFEES FOR 5 € ★</div>';
  }, 1500);

  // Carousel: changes every 2.5 s, cannot be paused
  $(function () {
    var i = 0, imgs = $(".slider img");
    if (imgs.length) setInterval(function () { imgs.removeClass("on"); i = (i + 1) % imgs.length; $(imgs[i]).addClass("on"); }, 2500);
  });

  console.log("page loaded at " + moment().format());
  trackPageView();  // function does not exist -> error in the console
</script>
</body>
</html>
